# HRAssist RAG Application — Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Gemini / OpenAI-compatible API ────────────────────────────────────────
# Base URL for the OpenAI-compatible Gemini API endpoint
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Your Google AI Studio API key (https://aistudio.google.com/app/apikey)
OPENAI_API_KEY=your_api_key_here

# ── Model names ───────────────────────────────────────────────────────────
# Chat/generation model used by the /query endpoint
CHAT_MODEL=gemini-2.0-flash-lite

# Embedding model used for indexing and retrieval
EMBED_MODEL=gemini-embedding-001

# ── FastAPI backend (used by the Streamlit frontend) ─────────────────────
# URL of the running FastAPI backend (default: local dev server)
RAG_API_URL=http://localhost:8000
